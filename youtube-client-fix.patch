+class DiagnosticLogger(QuietLogger):
+    """Keep yt-dlp quiet for the UI, but record which YouTube clients were tried.
+
+    Only player-client progress, playability status and warnings are kept, sanitized and
+    length-limited; raw extractor dumps, headers and cookies are never written.
+    """
+    _KEEP = re.compile(r"player API JSON|player response playability status", re.IGNORECASE)
+
+    def __init__(self):
+        self._lines = 0
+
+    def _record(self, status, message):
+        if self._lines < 40:
+            self._lines += 1
+            log_stage("ytdlp_" + status, "info", sanitize_diagnostic_text(message)[:300])
+
+    def debug(self, message):
+        if self._KEEP.search(str(message)):
+            self._record("trace", message)
+
+    def warning(self, message):
+        self._record("warning", message)
+
+    def error(self, message):
+        self._record("error", message)
+
+
+class DiagnosticYoutubeDL(YoutubeDL):
+    """YoutubeDL that forwards the extractor's playability-status debug lines (normally
+    verbose-only) to the diagnostic logger without enabling verbose mode."""
+
+    def write_debug(self, message, only_once=False):
+        logger = self.params.get("logger")
+        if isinstance(logger, DiagnosticLogger):
+            logger.debug(message)
+        else:
+            super().write_debug(message, only_once=only_once)
+
+
+def ytdlp_options(url: str, socket_timeout: int) -> dict:
+    """Options shared by metadata analysis and download, so both follow one YouTube config."""
+    options = {"quiet": True, "no_warnings": True, "noprogress": True, "logger": DiagnosticLogger(),
+               "noplaylist": True, "socket_timeout": socket_timeout}
+    if youtube_host(url):
+        options["extractor_args"] = youtube_extractor_args()
+    return options
+
+
+def log_youtube_request(stage: str, url: str, cookie_browser) -> None:
+    if youtube_host(url):
+        log_stage(stage, "request",
+                  f"app_version={APP_BUILD_VERSION} yt_dlp={YT_DLP_VERSION}/{YT_DLP_CHANNEL} "
+                  f"domain={urlparse(url).hostname} video_id={youtube_video_id(url)} "
+                  f"cookie_mode={'browser:' + cookie_browser if cookie_browser else 'off'} "
+                  f"extractor_args={json.dumps(youtube_extractor_args(), sort_keys=True)}")
+
+
+def log_youtube_clients_used(stage: str, info) -> None:
+    try:
+        clients = sorted({str(f.get("__yt_dlp_client")) for f in (info or {}).get("formats", []) if f.get("__yt_dlp_client")})
+        if clients:
+            log_stage(stage, "clients_used", ",".join(clients))
+    except Exception:
+        pass
+

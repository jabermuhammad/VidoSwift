+
+    def __init__(self, options):
+        self.options = options
+        self.cookiejar = object()
+        FakeYoutubeDL.instances.append(self)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        return False
+
+    def extract_info(self, url, download=False):
+        return {"id": "aqz-KE-bpKQ", "title": "Test", "extractor_key": "Youtube", "duration": 5,
+                "formats": [{"format_id": "18", "ext": "mp4", "height": 360, "vcodec": "avc1", "acodec": "mp4a", "__yt_dlp_client": "web_embedded"}]}
+
+    def download(self, urls):

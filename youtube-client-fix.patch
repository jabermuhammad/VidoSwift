+class YouTubeClientConfigTests(unittest.TestCase):
+    """Regression for "ERROR: [youtube] <id>: The page needs to be reloaded." (yt-dlp #17389).
+
+    2026.08.19 asks YouTube's `tv_downgraded` client for signed-in sessions; YouTube rejects it.
+    """
+
+    @staticmethod
+    def fake_cookie(name):
+        from http.cookiejar import Cookie
+        return Cookie(0, name, "x", None, False, ".youtube.com", True, True, "/", True, True, None, False, None, None, {})
+
+    def requested_clients(self, signed_in):
+        options = dict(app.ytdlp_options("https://www.youtube.com/watch?v=aqz-KE-bpKQ", 20))
+        options["logger"] = app.QuietLogger()
+        with app.YoutubeDL(options) as ydl:
+            if signed_in:  # fake cookies only make yt-dlp's own "is signed in" check true
+                for name in ("LOGIN_INFO", "SAPISID", "__Secure-3PAPISID", "__Secure-1PAPISID"):
+                    ydl.cookiejar.set_cookie(self.fake_cookie(name))
+            ie = ydl.get_info_extractor("Youtube")
+            ie.set_downloader(ydl)
+            ie.initialize()
+            return list(ie._get_requested_clients("https://www.youtube.com/watch?v=aqz-KE-bpKQ", {}, False))
+
+    def test_signed_in_sessions_never_request_the_rejected_client(self):
+        clients = self.requested_clients(signed_in=True)
+        self.assertNotIn("tv_downgraded", clients)
+        self.assertTrue(clients, "no clients requested")
+
+    def test_signed_out_default_still_avoids_the_rejected_client(self):
+        self.assertNotIn("tv_downgraded", self.requested_clients(signed_in=False))
+
+    def test_extractor_args_depend_on_bundled_ytdlp_version(self):
+        excluded = {"youtube": {"player_client": ["default", "-tv_downgraded"]}}
+        self.assertEqual(app.youtube_extractor_args("2026.08.19"), excluded)
+        self.assertEqual(app.youtube_extractor_args("2026.9.30"), excluded)
+        self.assertEqual(app.youtube_extractor_args("2026.10.10.233141"), {})
+        self.assertEqual(app.youtube_extractor_args("2026.10.10"), {})
+        self.assertEqual(app.youtube_extractor_args("2026.11.2"), {})
+        self.assertEqual(app.version_tuple("2026.10.10.233141.dev0"), (2026, 10, 10, 233141))
+
+    def test_non_youtube_urls_get_no_youtube_arguments(self):
+        self.assertNotIn("extractor_args", app.ytdlp_options("https://example.com/video.mp4", 20))
+        self.assertEqual(app.ytdlp_options("https://youtu.be/aqz-KE-bpKQ", 20)["extractor_args"], app.youtube_extractor_args())
+

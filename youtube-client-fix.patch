+# yt-dlp 2026.08.19 requests the `tv_downgraded` client for signed-in YouTube sessions. YouTube
+# answers it with "The page needs to be reloaded." (yt-dlp issue #17389). Upstream replaced it
+# with `tv_samsung` in nightly 2026.10.10 (PRs #17723 and #17805); no stable release has it yet.
+YT_DLP_YOUTUBE_FIX_VERSION = (2026, 10, 10)
+YOUTUBE_ID_PATTERNS = (
+    re.compile(r"[?&]v=([\w-]{11})"),
+    re.compile(r"(?:youtu\.be|/shorts|/embed|/live|/v)/([\w-]{11})"),
+)
+
+
+def version_tuple(value) -> tuple:
+    return tuple(int(part) for part in re.findall(r"\d+", str(value))[:4])
+
+
+def youtube_extractor_args(version=None) -> dict:
+    """yt-dlp extractor arguments applied identically to analysis and download.
+
+    Bundled yt-dlp older than the upstream fix must not use the broken client; newer
+    builds keep yt-dlp's own defaults (and `-tv_downgraded` would be a harmless no-op).
+    """
+    if version_tuple(YT_DLP_VERSION if version is None else version) >= YT_DLP_YOUTUBE_FIX_VERSION:
+        return {}
+    return {"youtube": {"player_client": ["default", "-tv_downgraded"]}}
+
+
+def youtube_video_id(url: str) -> str:
+    for pattern in YOUTUBE_ID_PATTERNS:
+        match = pattern.search(url or "")
+        if match:
+            return match.group(1)
+    return "unknown"
+
+

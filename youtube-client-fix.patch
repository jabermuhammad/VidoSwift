+    def test_home_directory_is_redacted_from_paths(self):
+        home = str(Path.home())
+        self.assertEqual(app.redact_home(f"{home}/AppData/Cookies"), "~/AppData/Cookies")
+        self.assertEqual(app.youtube_video_id("https://youtu.be/m0Xbd0DI458?t=3"), "m0Xbd0DI458")
+        self.assertEqual(app.youtube_video_id("https://example.com/x"), "unknown")
+
+
+class LocalNonYouTubeRegressionTests(unittest.TestCase):
+    """Real yt-dlp (generic extractor) against a throwaway local HTTP server: proves the shared
+    options/logger/DiagnosticYoutubeDL still analyse and download an ordinary video with no
+    internet, credentials or YouTube involved. valid_url is bypassed only because it
+    (correctly) refuses 127.0.0.1 in production."""
+
+    def test_metadata_and_download_of_a_direct_media_url(self):
+        import http.server
+        import socketserver
+
+        payload = b"\x00\x00\x00\x18ftypmp42" + b"\x00" * 4096
+
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def _headers(self):
+                self.send_response(200)
+                self.send_header("Content-Type", "video/mp4")
+                self.send_header("Content-Length", str(len(payload)))
+                self.end_headers()
+            def do_HEAD(self): self._headers()
+            def do_GET(self):
+                self._headers()
+                self.wfile.write(payload)
+            def log_message(self, *args): pass
+
+        server = socketserver.TCPServer(("127.0.0.1", 0), Handler)
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        self.addCleanup(server.server_close)
+        self.addCleanup(server.shutdown)
+        url = f"http://127.0.0.1:{server.server_address[1]}/sample.mp4"
+        temp = tempfile.TemporaryDirectory(dir=Path(__file__).resolve().parent)
+        self.addCleanup(temp.cleanup)
+        saved = (app.APP_DATA, app.STATE_FILE)
+        app.APP_DATA, app.STATE_FILE = Path(temp.name), Path(temp.name) / "state.json"
+        self.addCleanup(lambda: (setattr(app, "APP_DATA", saved[0]), setattr(app, "STATE_FILE", saved[1])))
+        folder = Path(temp.name) / "out"
+        folder.mkdir()
+        with unittest.mock.patch.dict("os.environ", {"NO_PROXY": "127.0.0.1", "no_proxy": "127.0.0.1", "HTTP_PROXY": "", "http_proxy": ""}), \
+             unittest.mock.patch.object(app, "valid_url", lambda value: value), \
+             unittest.mock.patch.object(app, "ensure_writable_temp_dir", lambda: Path(temp.name)):
+            api = app.VidoSwiftApi()
+            self.addCleanup(api._close)
+            api._ready_event.wait(3)
+            api._state["settings"]["folder"] = str(folder)
+            analysis = api.analyze(url)
+            self.assertTrue(analysis["ok"], analysis)
+            self.assertEqual(analysis["video"]["extractor"], "Generic")
+            self.assertTrue(analysis["video"]["title"])
+            job = {"id": "feedface00112233", "url": url, "title": "t", "quality": "best", "format": "mp4",
+                   "folder": str(folder), "status": "Queued", "progress": 0, "speed": "", "eta": "",
+                   "filepath": "", "error": "", "created": 0}
+            api._state["jobs"].insert(0, job)
+            api._download(job["id"])
+            self.assertEqual(api._state["jobs"][0]["status"], "Completed", api._state["jobs"][0].get("error"))
+            self.assertTrue(Path(api._state["jobs"][0]["filepath"]).stat().st_size > 0)
+
+
 if __name__ == "__main__":
     unittest.main()
